{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist-worker",

    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,

    "verbatimModuleSyntax": true,
    "noEmitHelpers": false
  },
  "include": [
    "src/workers/**/*.ts",
    "src/lib/**/*.ts"
  ]
}
